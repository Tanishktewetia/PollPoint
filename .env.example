NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
# Reserved for local operational scripts; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server runtime URL override (e.g. an isolated integration environment).
# SUPABASE_URL=http://127.0.0.1:54321
# Optional for migration deployment/bootstrap; supply locally, never commit.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# DATABASE_URL=postgresql://...

# Server-only requirement document generation.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
